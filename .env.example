# Zugangsdaten -- diese Datei kopieren nach .env und ausfüllen.
# install.sh erzeugt die Passwörter selbst, wenn du es laufen lässt.

POSTGRES_USER=wetterapp
POSTGRES_PASSWORD=
MQTT_PASSWORD=

# Port der Weboberfläche. Auf diesem Rechner ist 3000 z.B. schon von open-webui
# belegt -- dann hier etwas anderes eintragen.
APP_PORT=3000
# 127.0.0.1 heißt: nur lokal erreichbar. Für Zugriff aus dem LAN auf 0.0.0.0,
# besser aber einen Reverse Proxy mit HTTPS davorsetzen.
BIND_ADDR=127.0.0.1

# Der MQTT-Broker muss aus dem WLAN erreichbar sein, sonst kommt die Station nicht an.
MQTT_BIND=0.0.0.0
MQTT_PORT=1883
MQTT_USER=station

# Port der Datenbank auf dem Host, nur für Wartung. Auf diesem Rechner sind
# 5432, 5433 und 55432 schon belegt.
DB_PORT=55432

TZ=Europe/Berlin
